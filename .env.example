# Copy to .env and fill in. chmod 600 on the server.

# --- HTTP ---
# Keep HOST on loopback. /qr can link a device to the WhatsApp account, so the
# port must never be publicly reachable. Put nginx in front for remote callers.
HOST=127.0.0.1
PORT=3000

# Required. Generate with: openssl rand -hex 32
# The process refuses to start if this is missing or shorter than 32 chars.
API_KEY=

# Alternative to API_KEY: read the key from a file instead. Used only when API_KEY
# is unset. deploy/whatsapp-relay.service points this at a systemd LoadCredential
# path, which keeps the key out of `systemctl show` and /proc/<pid>/environ.
# API_KEY_FILE=/run/credentials/whatsapp-relay.service/api_key

# --- WhatsApp ---
# Absolute path preferred. Contents are a full account credential - mode 0700.
# Debian/systemd default: /var/lib/whatsapp-relay/auth
AUTH_DIR=./data/auth

# Optional. Default target when POST /send omits groupJid.
# Get it from GET /groups or `npm run find-group -- "Group Name"`.
DEFAULT_GROUP_JID=

# Ask WhatsApp to push the chat history after linking, which is what populates
# GET /chats. There is no RPC to fetch a chat list, so with this false the only
# listable conversations are groups. Only chat metadata is kept - never message
# bodies - so this does not turn the relay into a message archive.
SYNC_HISTORY=true

# Max messages accepted per API key per minute before 429.
RATE_LIMIT_PER_MINUTE=60

# --- Anti-ban pacing ---
# None of this hides the automation. Baileys speaks WhatsApp's real protocol, so the
# account is a normally linked device and every message is attributable to it. What
# these reduce is the behaviour enforcement keys on: uniform timing, bursts, volume,
# and round-the-clock activity. The strongest ban signal is still recipients blocking
# or reporting you, which no setting can fix.
HUMANIZE=true

# Minimum gap between two sends, plus a random extra up to SEND_JITTER_MS. A gap that
# is always exactly 1500 ms is itself a machine signature.
SEND_MIN_INTERVAL_MS=1500
SEND_JITTER_MS=2500

# "typing..." shown before each send, sized from the message length. 0 disables.
TYPING_CPS=18
TYPING_MAX_MS=6000

# Minimum gap between two messages to the SAME chat. 0 disables.
PER_TARGET_MIN_INTERVAL_MS=0

# Rolling-window volume ceilings; 0 disables. Start low on a fresh number and raise
# over a week or two. There is no warm-up code because the ramp is a judgement call.
HOURLY_SEND_LIMIT=0
DAILY_SEND_LIMIT=0

# Local hours when sends are refused with 503 quiet_hours, on a 24-hour clock, wrapping
# past midnight. Empty disables. Evaluated in QUIET_HOURS_TZ, not the server's clock.
# QUIET_HOURS=23-7
QUIET_HOURS_TZ=UTC

# Name shown in WhatsApp > Linked devices. Keep it stable: a descriptor that changes on
# every reconnect is more anomalous than any particular value. A label, not a disguise.
DEVICE_NAME=Chrome (Linux)

# --- Test console ---
# Browser page at / and /ui for linking (QR or pairing code) and exercising the API.
# It is refused for any non-loopback caller regardless of this setting; reach it with
#   ssh -L 3000:127.0.0.1:3000 user@host
# Set false to drop the routes entirely once linking is done.
ENABLE_UI=true

# --- Logging ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Set true only for local development (human-readable output via pino-pretty).
LOG_PRETTY=false
