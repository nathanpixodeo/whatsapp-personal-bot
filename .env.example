# Copy to .env and fill in. chmod 600 on the server.

# --- HTTP ---
# Keep HOST on loopback. /qr can link a device to the WhatsApp account, so the
# port must never be publicly reachable. Put nginx in front for remote callers.
HOST=127.0.0.1
PORT=3000

# Required. Generate with: openssl rand -hex 32
# The process refuses to start if this is missing or shorter than 32 chars.
API_KEY=

# Alternative to API_KEY: read the key from a file instead. Used only when API_KEY
# is unset. deploy/whatsapp-relay.service points this at a systemd LoadCredential
# path, which keeps the key out of `systemctl show` and /proc/<pid>/environ.
# API_KEY_FILE=/run/credentials/whatsapp-relay.service/api_key

# --- WhatsApp ---
# Absolute path preferred. Contents are a full account credential - mode 0700.
# Debian/systemd default: /var/lib/whatsapp-relay/auth
AUTH_DIR=./data/auth

# Optional. Default target when POST /send omits groupJid.
# Get it from GET /groups or `npm run find-group -- "Group Name"`.
DEFAULT_GROUP_JID=

# Ask WhatsApp to push the chat history after linking, which is what populates
# GET /chats. There is no RPC to fetch a chat list, so with this false the only
# listable conversations are groups. Only chat metadata is kept - never message
# bodies - so this does not turn the relay into a message archive.
SYNC_HISTORY=true

# Minimum gap between two sends. Pacing reduces rate-limit and ban risk.
SEND_MIN_INTERVAL_MS=1500

# Max messages accepted per API key per minute before 429.
RATE_LIMIT_PER_MINUTE=60

# --- Test console ---
# Browser page at / and /ui for linking (QR or pairing code) and exercising the API.
# It is refused for any non-loopback caller regardless of this setting; reach it with
#   ssh -L 3000:127.0.0.1:3000 user@host
# Set false to drop the routes entirely once linking is done.
ENABLE_UI=true

# --- Logging ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Set true only for local development (human-readable output via pino-pretty).
LOG_PRETTY=false
