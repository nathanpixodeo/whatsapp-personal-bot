{
  "name": "whatsapp-personal-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Authenticated HTTP relay that posts to WhatsApp groups through a linked personal account",
  "license": "AGPL-3.0-or-later",
  "author": "nathanpixodeo",
  "homepage": "https://github.com/nathanpixodeo/whatsapp-personal-bot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathanpixodeo/whatsapp-personal-bot.git"
  },
  "bugs": {
    "url": "https://github.com/nathanpixodeo/whatsapp-personal-bot/issues"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "fastify",
    "webhook",
    "notifications",
    "self-hosted"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "find-group": "tsx --env-file-if-exists=.env scripts/find-group.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "baileys": "7.0.0-rc14",
    "fastify": "^5.11.2",
    "lru-cache": "^11.5.2",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
